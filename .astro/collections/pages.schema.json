{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "lang": {
      "type": "string"
    },
    "collection": {
      "type": "string"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "publishAt": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "string"
    },
    "categorySlugs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "categoryNames": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tagSlugs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tagNames": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "redirectFrom": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "properties": {
            "type": "object",
            "propertyNames": {
